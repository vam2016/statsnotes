---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { allPosts, dateLabel, readingMinutes, url } from '../../lib/site';
export async function getStaticPaths() { return (await allPosts()).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const others = (await allPosts()).filter(p => p.id !== post.id).slice(0, 2);
---
<Base title={post.data.title} description={post.data.description} active="posts">
<div class="reading-progress" aria-hidden="true"></div>
<header class="article-header shell"><a class="back-link" href={url('posts/')}>← 全部文章</a><div class="article-labels"><span class="category-label">{post.data.category}</span>{post.data.demo && <span class="demo-badge">示例文章</span>}</div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="article-byline"><span class="author-avatar">τ</span><span>{post.data.author}</span><span>·</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>·</span><span>{readingMinutes(post.body)} 分钟阅读</span>{post.data.updated && <span>更新于 {dateLabel(post.data.updated)}</span>}</div></header>
<div class="article-layout shell"><article class="prose">{post.data.demo && <aside class="article-note">这是一篇用于展示排版与交互功能的示例文章，可在正式写作后替换。</aside>}<Content/><div class="article-tags">{post.data.tags.map(tag => <span>#{tag}</span>)}</div><div class="article-end"><span>— 札记到这里，思考还在继续。</span><button class="share-button"><Icon name="copy" size={16}/><span>复制文章链接</span></button></div></article><aside class="toc"><span class="eyebrow">本文目录</span><nav aria-label="文章目录">{headings.filter(h => h.depth <= 3).map(h => <a class:list={[{sub: h.depth === 3}]} href={`#${h.slug}`}>{h.text}</a>)}</nav><a href="#main" class="back-top">回到顶部 ↑</a></aside></div>
<section class="related shell"><h2>继续阅读</h2><div>{others.map(p => <a href={url(`posts/${p.id}/`)}><span>{p.data.category}</span><h3>{p.data.title}</h3><Icon name="arrow"/></a>)}</div></section>
<script>
  document.querySelector('.share-button')?.addEventListener('click', async event => {
    const span = (event.currentTarget as HTMLElement).querySelector('span')!;
    try { await navigator.clipboard.writeText(location.href); span.textContent = '链接已复制'; } catch { span.textContent = '请复制地址栏链接'; }
    setTimeout(() => { span.textContent = '复制文章链接'; }, 2200);
  });
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc nav a')];
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(entries => entries.forEach(e => { if (e.isIntersecting) links.forEach(l => l.classList.toggle('current', l.hash === `#${e.target.id}`)); }), { rootMargin: '-15% 0px -70% 0px' });
    document.querySelectorAll('.prose h2, .prose h3').forEach(h => obs.observe(h));
  }
</script>
</Base>
