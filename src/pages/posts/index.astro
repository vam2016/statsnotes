---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { allPosts } from '../../lib/site';
const posts = await allPosts();
---
<Base title="文章归档" active="posts"><div class="shell page-top"><span class="eyebrow">THE NOTEBOOK</span><h1>写下来，想明白。</h1><p>临床问题、统计方法，以及实践中的细节。</p></div><section class="shell archive-section"><ArticleList posts={posts}/></section></Base>
