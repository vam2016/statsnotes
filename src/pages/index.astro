---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BookShelf from '../components/BookShelf.astro';
import { allPosts, url, dateLabel, readingMinutes } from '../lib/site';
const notes = (await allPosts()).filter(p => p.data.kind === 'note');
const latest = notes[0];
---
<Base>
  <section class="notebook-hero shell"><div class="notebook-intro"><div class="eyebrow"><span class="eyebrow-line"></span>CLINICAL TRIALS / BIOSTATISTICS</div><h1>零散的思考，<br/><span class="blue-text">系统的积累。</span></h1><p>在数据与临床之间，记录一个问题的理解，<br class="desktop-break"/>也记录一本书的学习过程。</p><div class="notebook-shortcuts"><a href={url('notes/')}>零散笔记 <Icon name="arrow" size={17}/></a><a href={url('books/')}>读书笔记 <Icon name="book" size={17}/></a></div></div>{latest && <a class="featured-note" href={url(`posts/${latest.id}/`)}><div class="featured-note-top"><span class="eyebrow">最近写下</span><span>{dateLabel(latest.data.date)}</span></div><span class="featured-category">{latest.data.category}{latest.data.demo && <i>示例笔记</i>}</span><h2>{latest.data.title}</h2><p>{latest.data.description}</p><div class="featured-note-bottom"><span>{readingMinutes(latest.body)} 分钟阅读</span><span>打开笔记 <Icon name="arrow" size={18}/></span></div><span class="note-corner" aria-hidden="true">τ</span></a>}</section>
  <section class="notebook-section shell" id="notes"><div class="section-heading"><div><span class="eyebrow">FIELD NOTES</span><h2>零散笔记</h2><p class="section-description">一个问题，一点发现。按主题收好每次思考。</p></div><a class="text-link" href={url('notes/')}>查看全部 <Icon name="arrow" size={17}/></a></div><div class="note-list">{notes.slice(0, 4).map(note => <article class="note-row reveal"><a href={url(`posts/${note.id}/`)}><time datetime={note.data.date.toISOString()}>{dateLabel(note.data.date)}</time><div class="note-row-main"><h3>{note.data.title}</h3><p>{note.data.description}</p></div><div class="note-row-labels"><span>{note.data.category}</span>{note.data.demo && <span class="demo-badge">示例笔记</span>}</div><Icon name="arrow" size={20}/></a></article>)}</div>{!notes.length && <p class="empty-notes">第一篇零散笔记正在酝酿中。</p>}</section>
  <section class="notebook-section shell books-home"><div class="section-heading"><div><span class="eyebrow">READING JOURNAL</span><h2>读书笔记</h2><p class="section-description">围绕一本书，沿着章节，把理解连成一条线。</p></div><a class="text-link" href={url('books/')}>打开书架 <Icon name="arrow" size={17}/></a></div><BookShelf limit={2}/></section>
</Base>
