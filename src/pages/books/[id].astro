---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { bookShelves, url, dateLabel, readingMinutes } from '../../lib/site';
export async function getStaticPaths() { return (await bookShelves()).map(book => ({ params: { id: book.id }, props: { book } })); }
const { book } = Astro.props;
---
<Base title={book.data.title} description={book.data.description} active="books"><header class="book-header shell"><a class="back-link" href={url('books/')}>← 读书笔记</a><div class="book-header-grid"><div class:list={['book-object', `book-color-${book.data.color}`]} aria-hidden="true"><span class="book-cover-eyebrow">TRIAL NOTES / STUDY</span><strong>{book.data.title}</strong><span class="book-cover-bottom">{book.data.author || '按章节，慢慢理解。'}</span></div><div><span class="eyebrow">READING JOURNAL</span>{book.data.demo && <span class="demo-badge book-demo">结构示例</span>}<h1>{book.data.title}</h1>{book.data.author && <p class="book-author">{book.data.author}{book.data.edition && ` · ${book.data.edition}`}</p>}<p>{book.data.description}</p><div class="book-header-meta"><span>{book.chapters.length} 篇章节笔记</span>{book.updated && <span>最近更新 {dateLabel(book.updated)}</span>}</div>{book.chapters[0] && <a class="button primary-button" href={url(`posts/${book.chapters[0].id}/`)}>从第一篇开始 <Icon name="arrow" size={17}/></a>}</div></div></header><section class="chapter-list shell"><div class="section-heading"><div><span class="eyebrow">CONTENTS</span><h2>学习目录</h2></div></div>{book.chapters.map(chapter => <article class="chapter-row"><a href={url(`posts/${chapter.id}/`)}><span class="chapter-number">{String(chapter.data.chapter).padStart(2, '0')}</span><div><h3>{chapter.data.title}</h3><p>{chapter.data.description}</p></div><span class="chapter-time">{readingMinutes(chapter.body)} 分钟<time>{dateLabel(chapter.data.date)}</time></span><Icon name="arrow" size={18}/></a></article>)}{!book.chapters.length && <p class="empty-notes">目录已准备好，第一篇章节笔记正在整理中。</p>}</section></Base>
